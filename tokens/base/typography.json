{
  "font": {
    "family": {
      "base": {
        "$type": "fontFamily",
        "$value": ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"],
        "$description": "Default font family for body text"
      },
      "heading": {
        "$type": "fontFamily",
        "$value": ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "Roboto", "sans-serif"],
        "$description": "Font family for headings"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["JetBrains Mono", "SF Mono", "Monaco", "Inconsolata", "Fira Code", "Droid Sans Mono", "Consolas", "monospace"],
        "$description": "Monospace font family for code"
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": "0.75rem",
        "$description": "Extra small font size - 12px"
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.875rem",
        "$description": "Small font size - 14px"
      },
      "base": {
        "$type": "dimension",
        "$value": "1rem",
        "$description": "Base font size - 16px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "1.125rem",
        "$description": "Large font size - 18px"
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.25rem",
        "$description": "Extra large font size - 20px"
      },
      "2xl": {
        "$type": "dimension",
        "$value": "1.5rem",
        "$description": "2X large font size - 24px"
      },
      "3xl": {
        "$type": "dimension",
        "$value": "1.875rem",
        "$description": "3X large font size - 30px"
      },
      "4xl": {
        "$type": "dimension",
        "$value": "2.25rem",
        "$description": "4X large font size - 36px"
      },
      "5xl": {
        "$type": "dimension",
        "$value": "3rem",
        "$description": "5X large font size - 48px"
      },
      "6xl": {
        "$type": "dimension",
        "$value": "3.75rem",
        "$description": "6X large font size - 60px"
      }
    },
    "weight": {
      "thin": {
        "$type": "fontWeight",
        "$value": "100",
        "$description": "Thin font weight"
      },
      "extralight": {
        "$type": "fontWeight",
        "$value": "200",
        "$description": "Extra light font weight"
      },
      "light": {
        "$type": "fontWeight",
        "$value": "300",
        "$description": "Light font weight"
      },
      "normal": {
        "$type": "fontWeight",
        "$value": "400",
        "$description": "Normal font weight"
      },
      "medium": {
        "$type": "fontWeight",
        "$value": "500",
        "$description": "Medium font weight"
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": "600",
        "$description": "Semi-bold font weight"
      },
      "bold": {
        "$type": "fontWeight",
        "$value": "700",
        "$description": "Bold font weight"
      },
      "extrabold": {
        "$type": "fontWeight",
        "$value": "800",
        "$description": "Extra bold font weight"
      },
      "black": {
        "$type": "fontWeight",
        "$value": "900",
        "$description": "Black font weight"
      }
    },
    "lineHeight": {
      "none": {
        "$type": "number",
        "$value": 1,
        "$description": "No line height"
      },
      "tight": {
        "$type": "number", 
        "$value": 1.25,
        "$description": "Tight line height"
      },
      "snug": {
        "$type": "number",
        "$value": 1.375,
        "$description": "Snug line height"
      },
      "normal": {
        "$type": "number",
        "$value": 1.5,
        "$description": "Normal line height"
      },
      "relaxed": {
        "$type": "number",
        "$value": 1.625,
        "$description": "Relaxed line height"
      },
      "loose": {
        "$type": "number",
        "$value": 2,
        "$description": "Loose line height"
      }
    }
  }
}